# ============================================================
# Supabase
# ============================================================
# Panel de Supabase → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# Project Settings → API Keys → service_role. SOLO del lado del servidor:
# saltea RLS. Nunca la pongas en una variable NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
#
# Con una base LOCAL (`supabase start`, necesita Docker): la URL es
# http://127.0.0.1:54321 y las dos claves las muestra `supabase status`.

# ============================================================
# Marca (white label)
# ============================================================
# Nombre, logo y color salen de aca, nunca de un valor escrito en el codigo
# (lib/brand.ts). Son NEXT_PUBLIC_*, asi que se fijan en el build: cambiarlas
# en Railway pide un redeploy.
#
# Es la marca de la INSTALACION: la del login y el icono de la pestaña, y la
# que usa cada negocio que no cargo la suya. Cada negocio (workspace) puede
# tener su propio nombre, logo, color y tono de la IA en
# Ajustes → General → Marca.
#
# Sin NEXT_PUBLIC_BRAND_NAME el sistema muestra un nombre generico.
# Sin NEXT_PUBLIC_BRAND_LOGO_URL se muestra un monograma con la inicial del
# nombre, sobre el color de marca (o el color por defecto si tampoco hay).
NEXT_PUBLIC_BRAND_NAME=Nombre del negocio
# NEXT_PUBLIC_BRAND_LOGO_URL=https://.../logo.png
# NEXT_PUBLIC_BRAND_COLOR=#4f46e5

# Como escribe el agente en español (lib/ai/language-style.ts). Server-only
# (no NEXT_PUBLIC_): solo la leen los prompts de IA, que corren en el
# servidor. Sin esto, "español neutro, directo y sin relleno". Un negocio con
# tono propio (Ajustes → General → Marca) usa el suyo.
# AI_LANGUAGE_STYLE=español rioplatense (vos/tenés)

# ============================================================
# App
# ============================================================
# Dominio publico de la app. Ademas de armar los links de invitacion y de la
# agenda, es la URL que se registra en Zernio y en Evolution para que manden
# sus webhooks: si apunta a localhost no entra ni un mensaje, y por eso el
# registro se niega a hacerlo (lib/webhook-url.ts).
# En Railway: Settings -> Networking -> Public Domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Protege /api/cron/*. Cualquier string aleatorio largo:
#   openssl rand -hex 32
#
# Quien le pega a esas rutas es la base: los cron corren con pg_cron dentro de
# Supabase, no con un servicio externo. Por eso este mismo valor tiene que
# estar cargado ADEMAS en Supabase Vault, junto con la URL publica de la app.
# En el SQL Editor de Supabase, una vez por instalacion:
#
#   select private.set_system_secret('app_url', 'https://tu-app.up.railway.app');
#   select private.set_system_secret('cron_secret', 'el-mismo-valor-de-aca');
#
# O desde el panel: Integrations -> Vault -> Secrets -> Add new secret, con
# Name exactamente `system:app_url` / `system:cron_secret`. Para CAMBIARLOS
# despues (por ejemplo, al pasar a un dominio propio) usar la linea de
# set_system_secret: Vault no deja crear dos con el mismo nombre.
# Para comprobar sin ver el secreto:
#
#   select * from private.system_secrets_status();
#
# Si los dos valores no coinciden, los cron responden 401 (se ve en
# calls_401_15m) y las secuencias, las esperas de los flujos y el disparador
# de inactividad dejan de correr. En el .env LOCAL no hace falta que sea el
# mismo: ningun cron de produccion le pega a localhost.
# El secreto viaja SOLO por el header Authorization: Bearer <CRON_SECRET>.
# Un cron externo hecho a mano con ?key=... en la URL no autoriza.
CRON_SECRET=tu-cron-secret

# ============================================================
# Instagram (Zernio)
# ============================================================
# Los webhooks de los dos canales los recibe la app:
#   Instagram -> /api/webhooks/late      (firma HMAC)
#   WhatsApp  -> /api/webhooks/evolution (token compartido)
#
# La API key de Zernio NO va aca: se pega en Ajustes -> Integraciones y se
# guarda cifrada en Supabase Vault, por negocio. El secreto para validar la
# firma de sus webhooks lo genera la app sola (workspaces.webhook_secret).

# ============================================================
# WhatsApp (Evolution API, Baileys)
# ============================================================
# URL del servicio de Evolution. En Railway: Settings → Networking → Public
# Domain. Si la app y Evolution estan en el MISMO proyecto de Railway, podes
# usar la URL de la red privada interna para que no salga a internet.
EVOLUTION_API_URL=https://tu-evolution.up.railway.app

# API key global de Evolution: es el valor de la variable AUTHENTICATION_API_KEY
# del servicio de Evolution en Railway.
EVOLUTION_API_KEY=tu-evolution-api-key

# Prefijo de las instancias que crea ESTA instalacion. Sirve para no chocar con
# las instancias de otro sistema si compartis el mismo Evolution. No lo cambies
# una vez que ya hay instancias creadas: el canal las busca por nombre.
EVOLUTION_INSTANCE_PREFIX=ssa

# Token compartido que Evolution manda en el header x-webhook-token y que
# /api/webhooks/evolution exige. Es lo unico que separa un evento real de
# cualquiera que descubra la URL publica del webhook. Generalo con:
#   openssl rand -hex 32
# Se configura solo en la app: cuando se crea la instancia de WhatsApp, la app
# se lo pasa a Evolution para que lo mande en cada evento. Tambien se puede
# cargar por pantalla (Ajustes -> Integraciones): esta variable queda de
# respaldo.
EVOLUTION_WEBHOOK_TOKEN=

# ============================================================
# Integraciones: las claves NO van en este archivo
# ============================================================
# Todos los demas secretos viven en Supabase Vault y se cargan desde
# Ajustes -> Integraciones. De un secreto guardado, la pantalla solo sabe que
# EXISTE: el valor nunca vuelve del servidor.
#
#   Zernio (Instagram, TikTok)  -> API key, en app.zern.io
#   Evolution API (WhatsApp)    -> URL, API key y token del webhook
#   OpenAI / Anthropic / Google -> tu propia clave (BYOK): generan TEXTO
#   Voyage AI                   -> embeddings de la base de conocimiento
#   Resend (email saliente)     -> API key, en resend.com
#   Resend (email entrante)     -> secreto del webhook (Svix) y la direccion
#                                  del subdominio configurado en Resend
#   Google (Calendar, YouTube)  -> client id y secret de un proyecto de Google
#                                  Cloud con las APIs habilitadas
#   Postproxy (YouTube)         -> API key, en postproxy.dev
#   LinkedIn                    -> client id y secret de una app de LinkedIn
#   Threads                     -> app id y secret de una app de Meta
#   Meta (anuncios e Instagram) -> token de system user con ads_read, en el
#                                  Business Manager
#
# Por que en Vault y no aca: una variable de entorno la ve cualquiera que
# entre al panel de Railway, se copia en un backup del .env y no se puede
# rotar sin un deploy. Vault las cifra con AES-256 y el valor nunca sale del
# servidor.
#
# El sistema funciona sin ninguna conectada: los emails quedan registrados como
# pendientes y las invitaciones muestran el link en pantalla para pasarlo a
# mano. Sin la key de Voyage la base de conocimiento no indexa (los documentos
# quedan pendientes) y el resto sigue igual. Voyage y el proveedor de chat son
# independientes: se puede usar Anthropic para conversar y Voyage para indexar.
#
# Modelo de embeddings por defecto: voyage-4-lite, 1024 dimensiones. La columna
# knowledge_chunks.embedding esta anclada a extensions.vector(1024): cambiar de
# modelo o de dimension obliga a cambiar el tipo de la columna, recrear el
# indice HNSW y REINDEXAR todos los documentos.

# ============================================================
# Agenda
# ============================================================
# Sal del hash de la IP en el tope de los endpoints publicos de la agenda. La
# IP nunca se guarda en texto: se guarda SHA-256(ip + sal). Cualquier cadena
# larga y aleatoria sirve; cambiarla solo resetea los contadores en curso.
# Si no esta, se deriva una sal de CRON_SECRET (funciona, pero conviene tener
# la propia: rotar CRON_SECRET no deberia tocar los topes).
RATE_LIMIT_SALT=una-cadena-larga-y-aleatoria
