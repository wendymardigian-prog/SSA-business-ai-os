{
  "_comment": "Casos de accessWindow y untilReached (F37, F109). Corren contra lib/portal-admin/access.ts y contra app_servicio.portal_access_window / portal_access_until_reached (verify-services --bloque ac). Fechas = días del negocio.",
  "window": [
    { "name": "desde el inicio, lo que dure el servicio", "input": { "rule": { "opens": { "type": "service_start" }, "until": { "type": "service" } }, "event": { "type": "service_start" }, "startsOn": "2026-11-01", "endsOn": "2027-01-31", "today": "2026-11-01" }, "expected": { "action": "open", "endsOn": "2027-01-31", "untilType": "service" } },
    { "name": "sin reglas = desde el inicio y lo que dure el servicio", "input": { "rule": {}, "event": { "type": "service_start" }, "startsOn": "2026-11-01", "endsOn": null, "today": "2026-11-01" }, "expected": { "action": "open", "endsOn": null, "untilType": "service" } },
    { "name": "desde el inicio, 12 meses desde que se abre", "input": { "rule": { "opens": { "type": "service_start" }, "until": { "type": "months", "n": 12 } }, "event": { "type": "service_start" }, "startsOn": "2026-11-01", "endsOn": "2027-01-31", "today": "2026-11-01" }, "expected": { "action": "open", "endsOn": "2027-11-01", "untilType": "months" } },
    { "name": "meses que caen en un día que no existe", "input": { "rule": { "until": { "type": "months", "n": 1 } }, "event": { "type": "service_start" }, "startsOn": "2027-01-31", "endsOn": null, "today": "2027-01-31" }, "expected": { "action": "open", "endsOn": "2027-02-28", "untilType": "months" } },
    { "name": "30 días desde que se abre", "input": { "rule": { "until": { "type": "days", "n": 30 } }, "event": { "type": "service_start" }, "startsOn": "2026-11-01", "endsOn": null, "today": "2026-11-01" }, "expected": { "action": "open", "endsOn": "2026-12-01", "untilType": "days" } },
    { "name": "para siempre", "input": { "rule": { "until": { "type": "forever" } }, "event": { "type": "service_start" }, "startsOn": "2026-11-01", "endsOn": "2027-01-31", "today": "2026-11-01" }, "expected": { "action": "open", "endsOn": null, "untilType": "forever" } },
    { "name": "hasta una fecha fija", "input": { "rule": { "until": { "type": "fixed_date", "date": "2026-12-24" } }, "event": { "type": "service_start" }, "startsOn": "2026-11-01", "endsOn": "2027-01-31", "today": "2026-11-01" }, "expected": { "action": "open", "endsOn": "2026-12-24", "untilType": "fixed_date" } },
    { "name": "una fecha fija que ya pasó no abre", "input": { "rule": { "until": { "type": "fixed_date", "date": "2026-10-01" } }, "event": { "type": "service_start" }, "startsOn": "2026-11-01", "endsOn": null, "today": "2026-11-01" }, "expected": { "action": "none" } },
    { "name": "hasta completar una fase: sin fecha", "input": { "rule": { "until": { "type": "phase_completed", "ref": "ph_aaaaa1" } }, "event": { "type": "service_start" }, "startsOn": "2026-11-01", "endsOn": "2027-01-31", "today": "2026-11-01" }, "expected": { "action": "open", "endsOn": null, "untilType": "phase_completed" } },
    { "name": "7 días después del inicio: todavía no", "input": { "rule": { "opens": { "type": "days_after_start", "days": 7 } }, "event": { "type": "service_start" }, "startsOn": "2026-11-01", "endsOn": "2027-01-31", "today": "2026-11-01" }, "expected": { "action": "none" } },
    { "name": "7 días después del inicio: el día justo (cron)", "input": { "rule": { "opens": { "type": "days_after_start", "days": 7 } }, "event": { "type": "tick" }, "startsOn": "2026-11-01", "endsOn": "2027-01-31", "today": "2026-11-08" }, "expected": { "action": "open", "endsOn": "2027-01-31", "untilType": "service" } },
    { "name": "7 días después del inicio: un día antes (cron)", "input": { "rule": { "opens": { "type": "days_after_start", "days": 7 } }, "event": { "type": "tick" }, "startsOn": "2026-11-01", "endsOn": "2027-01-31", "today": "2026-11-07" }, "expected": { "action": "none" } },
    { "name": "fecha fija de apertura que llegó (cron)", "input": { "rule": { "opens": { "type": "fixed_date", "date": "2026-11-15" } }, "event": { "type": "tick" }, "startsOn": "2026-11-01", "endsOn": null, "today": "2026-11-15" }, "expected": { "action": "open", "endsOn": null, "untilType": "service" } },
    { "name": "fecha fija de apertura que no llegó", "input": { "rule": { "opens": { "type": "fixed_date", "date": "2026-11-15" } }, "event": { "type": "tick" }, "startsOn": "2026-11-01", "endsOn": null, "today": "2026-11-14" }, "expected": { "action": "none" } },
    { "name": "al completar la fase indicada", "input": { "rule": { "opens": { "type": "phase_completed", "ref": "ph_onbrd1" }, "until": { "type": "service" } }, "event": { "type": "phase_completed", "ref": "ph_onbrd1" }, "startsOn": "2026-11-01", "endsOn": "2027-01-31", "today": "2026-11-20" }, "expected": { "action": "open", "endsOn": "2027-01-31", "untilType": "service" } },
    { "name": "al completar OTRA fase no abre", "input": { "rule": { "opens": { "type": "phase_completed", "ref": "ph_onbrd1" } }, "event": { "type": "phase_completed", "ref": "ph_otra01" }, "startsOn": "2026-11-01", "endsOn": "2027-01-31", "today": "2026-11-20" }, "expected": { "action": "none" } },
    { "name": "una regla de fase no abre al inicio", "input": { "rule": { "opens": { "type": "phase_completed", "ref": "ph_onbrd1" } }, "event": { "type": "service_start" }, "startsOn": "2026-11-01", "endsOn": "2027-01-31", "today": "2026-11-01" }, "expected": { "action": "none" } },
    { "name": "al completar un paso", "input": { "rule": { "opens": { "type": "item_completed", "ref": "it_kickof" } }, "event": { "type": "item_completed", "ref": "it_kickof" }, "startsOn": "2026-11-01", "endsOn": null, "today": "2026-11-03" }, "expected": { "action": "open", "endsOn": null, "untilType": "service" } },
    { "name": "al completar un módulo", "input": { "rule": { "opens": { "type": "module_completed", "ref": "11111111-1111-4111-8111-111111111111" } }, "event": { "type": "module_completed", "ref": "11111111-1111-4111-8111-111111111111" }, "startsOn": "2026-11-01", "endsOn": null, "today": "2026-11-03" }, "expected": { "action": "open", "endsOn": null, "untilType": "service" } },
    { "name": "al empezar el Reto", "input": { "rule": { "opens": { "type": "challenge_started" }, "until": { "type": "phase_completed", "ref": "ph_implem" } }, "event": { "type": "challenge_started" }, "startsOn": "2026-11-01", "endsOn": null, "today": "2026-11-10" }, "expected": { "action": "open", "endsOn": null, "untilType": "phase_completed" } },
    { "name": "un paso «Se abre» no lo abre un hecho", "input": { "rule": { "opens": { "type": "journey_item" } }, "event": { "type": "tick" }, "startsOn": "2026-11-01", "endsOn": null, "today": "2026-11-10" }, "expected": { "action": "none" } },
    { "name": "por automatización no lo abre el cron", "input": { "rule": { "opens": { "type": "automation" } }, "event": { "type": "service_start" }, "startsOn": "2026-11-01", "endsOn": null, "today": "2026-11-01" }, "expected": { "action": "none" } },
    { "name": "un servicio que ya terminó no abre lo que dura el servicio", "input": { "rule": {}, "event": { "type": "tick" }, "startsOn": "2026-01-01", "endsOn": "2026-06-30", "today": "2026-11-01" }, "expected": { "action": "none" } }
  ],
  "until": [
    { "name": "completar la fase del «hasta» cierra", "until": { "type": "phase_completed", "ref": "ph_implem" }, "event": { "type": "phase_completed", "ref": "ph_implem" }, "expected": true },
    { "name": "otra fase no cierra", "until": { "type": "phase_completed", "ref": "ph_implem" }, "event": { "type": "phase_completed", "ref": "ph_onbrd1" }, "expected": false },
    { "name": "completar el paso del «hasta» cierra", "until": { "type": "item_completed", "ref": "it_final1" }, "event": { "type": "item_completed", "ref": "it_final1" }, "expected": true },
    { "name": "un paso no cierra un «hasta la fase»", "until": { "type": "phase_completed", "ref": "it_final1" }, "event": { "type": "item_completed", "ref": "it_final1" }, "expected": false },
    { "name": "lo que dure el servicio no lo cierra un hecho", "until": { "type": "service" }, "event": { "type": "phase_completed", "ref": "ph_implem" }, "expected": false },
    { "name": "sin ref no cierra", "until": { "type": "phase_completed" }, "event": { "type": "phase_completed", "ref": "ph_implem" }, "expected": false }
  ]
}
