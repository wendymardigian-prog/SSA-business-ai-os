      "total": 1548,
      "ctx": { "todayLocal": "2026-10-20", "month": "2026-10", "chargeMode": "automatic" },
      "expected": { "kind": "create", "amountCents": 1548, "status": "programado", "scheduledDate": "2026-10-31" }
    },
    {
