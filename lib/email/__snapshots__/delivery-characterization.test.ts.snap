exports[`caracterizacion: los emails del sistema (templates.ts) > invitacion, aviso al equipo, link de baja y el marco > aviso 1`] = `
{
  "html": "<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="supported-color-schemes" content="light" />
  </head>
  <body style="margin:0;padding:0;background:#f3f4f6;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#111827;-webkit-font-smoothing:antialiased;">
    <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;font-size:1px;line-height:1px;">Ana te escribió</div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f3f4f6" style="background:#f3f4f6;">
      <tr>
        <td align="center" style="padding:32px 16px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;background:#ffffff;border:1px solid #e5e7eb;border-radius:16px;border-collapse:separate;overflow:hidden;">
            <tr>
              <td height="6" bgcolor="#7c3aed" style="height:6px;line-height:6px;font-size:0;background:#7c3aed;">&nbsp;</td>
            </tr>
            <tr>
              <td align="center" style="padding:32px 40px 8px;text-align:center;">
                <table role="presentation" align="center" cellpadding="0" cellspacing="0" border="0" style="margin:0 auto;border-collapse:separate;">
          <tr>
            <td width="56" height="56" align="center" valign="middle" bgcolor="#7c3aed" style="width:56px;height:56px;border-radius:14px;background:#7c3aed;color:#ffffff;font-size:26px;font-weight:700;line-height:56px;text-align:center;">M</td>
          </tr>
        </table>
        <p style="margin:12px 0 0;font-size:14px;font-weight:600;color:#374151;letter-spacing:0.01em;">Mi Negocio</p>
              </td>
            </tr>
            <tr>
              <td style="padding:0 40px;">
                <div style="height:1px;line-height:1px;font-size:0;background:#f0f1f3;margin:16px 0 0;">&nbsp;</div>
              </td>
            </tr>
            <tr>
              <td style="padding:28px 40px 36px;font-size:15px;line-height:1.6;color:#111827;">
                
                <p style="margin:0 0 8px;font-size:12px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#7c3aed;">Aviso</p>
                <h1 style="margin:0 0 12px;font-size:22px;line-height:1.3;font-weight:700;color:#111827;">Te asignaron un chat</h1>
                <p style="margin:0;font-size:15px;line-height:1.6;color:#374151;">Ana te escribió</p>
                <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin:28px auto 0;border-collapse:separate;">
      <tr>
        <td align="center" bgcolor="#7c3aed" style="border-radius:10px;background:#7c3aed;">
          <a href="https://app.test/x" target="_blank" style="display:inline-block;padding:14px 32px;font-size:15px;font-weight:600;line-height:1.2;color:#ffffff;text-decoration:none;border-radius:10px;">Ver en el sistema</a>
        </td>
      </tr>
    </table>
    <p style="margin:28px 0 0;font-size:12px;line-height:1.6;color:#6b7280;">
      ¿El botón no funciona? Copiá y pegá este link en tu navegador:<br />
      <a href="https://app.test/x" target="_blank" style="color:#7c3aed;word-break:break-all;">https://app.test/x</a>
    </p>
              </td>
            </tr>
          </table>
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;">
            <tr>
              <td align="center" style="padding:20px 24px 0;font-size:12px;line-height:1.6;color:#9ca3af;text-align:center;">
                Te llega porque lo elegiste en Mi cuenta. <a href="https://app.test/cuenta" target="_blank" style="color:#6b7280;text-decoration:underline;">Cambiar qué avisos recibo</a><br />Enviado por Mi Negocio
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>",
  "subject": "Mi Negocio: Te asignaron un chat",
}
`;

