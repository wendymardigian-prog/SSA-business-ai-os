{
  "_comment": "Casos de submissionPlan (F126). Corren contra lib/program/submission-limits.ts y contra app_servicio.submission_plan (verify-program --bloque a3). history va de la entrega más vieja a la más nueva.",
  "cases": [
    { "name": "sin límites configurados: como antes, sin reemplazo", "limits": null, "history": [{ "id": "a", "status": "pending" }], "expected": { "ok": true, "supersede": null } },
    { "name": "sin límites configurados: aprobada igual entrega (como antes)", "limits": null, "history": [{ "id": "a", "status": "reviewed" }], "expected": { "ok": true, "supersede": null } },
    { "name": "primera entrega", "limits": { "before_review": null, "after_review": 2 }, "history": [], "expected": { "ok": true, "supersede": null } },
    { "name": "corrección antes de la revisión, sin límite: reemplaza", "limits": { "before_review": null, "after_review": 2 }, "history": [{ "id": "a", "status": "superseded" }, { "id": "b", "status": "pending" }], "expected": { "ok": true, "supersede": "b" } },
    { "name": "límite 0 antes de la revisión: no se corrige", "limits": { "before_review": 0, "after_review": 2 }, "history": [{ "id": "a", "status": "pending" }], "expected": { "ok": false, "code": "EV003", "message": "Ya usaste todas las correcciones antes de la revisión" } },
    { "name": "límite N antes de la revisión: queda una", "limits": { "before_review": 2, "after_review": 2 }, "history": [{ "id": "a", "status": "superseded" }, { "id": "b", "status": "pending" }], "expected": { "ok": true, "supersede": "b" } },
    { "name": "límite N antes de la revisión: agotado", "limits": { "before_review": 2, "after_review": 2 }, "history": [{ "id": "a", "status": "superseded" }, { "id": "b", "status": "superseded" }, { "id": "c", "status": "pending" }], "expected": { "ok": false, "code": "EV003", "message": "Ya usaste todas las correcciones antes de la revisión" } },
    { "name": "aprobada no se reentrega", "limits": { "before_review": null, "after_review": 2 }, "history": [{ "id": "a", "status": "reviewed", "passed": true }], "expected": { "ok": false, "code": "EV004", "message": "Esta entrega ya está aprobada" } },
    { "name": "revisada sin calificación cuenta como aprobada", "limits": { "before_review": null, "after_review": null }, "history": [{ "id": "a", "status": "reviewed", "passed": null }], "expected": { "ok": false, "code": "EV004", "message": "Esta entrega ya está aprobada" } },
    { "name": "no aprobó: entrega nueva dentro del límite", "limits": { "before_review": null, "after_review": 2 }, "history": [{ "id": "a", "status": "reviewed", "passed": false }], "expected": { "ok": true, "supersede": null } },
    { "name": "no aprobó dos veces con límite 2: queda la segunda", "limits": { "before_review": null, "after_review": 2 }, "history": [{ "id": "a", "status": "reviewed", "passed": false }, { "id": "b", "status": "reviewed", "passed": false }], "expected": { "ok": true, "supersede": null } },
    { "name": "límite después de la revisión agotado", "limits": { "before_review": null, "after_review": 2 }, "history": [{ "id": "a", "status": "reviewed", "passed": false }, { "id": "b", "status": "reviewed", "passed": false }, { "id": "c", "status": "reviewed", "passed": false }], "expected": { "ok": false, "code": "EV003", "message": "Ya no quedan entregas nuevas para esta actividad" } },
    { "name": "límite 0 después de la revisión", "limits": { "before_review": null, "after_review": 0 }, "history": [{ "id": "a", "status": "reviewed", "passed": false }], "expected": { "ok": false, "code": "EV003", "message": "Ya no quedan entregas nuevas para esta actividad" } },
    { "name": "sin límite después de la revisión", "limits": { "before_review": null, "after_review": null }, "history": [{ "id": "a", "status": "reviewed", "passed": false }, { "id": "b", "status": "reviewed", "passed": false }, { "id": "c", "status": "reviewed", "passed": false }], "expected": { "ok": true, "supersede": null } },
    { "name": "pedir otra entrega con el límite agotado: habilita una más", "limits": { "before_review": null, "after_review": 0 }, "history": [{ "id": "a", "status": "reviewed", "passed": false }, { "id": "b", "status": "needs_changes" }], "expected": { "ok": true, "supersede": null } },
    { "name": "pedir otra entrega no gasta del límite", "limits": { "before_review": null, "after_review": 1 }, "history": [{ "id": "a", "status": "needs_changes" }, { "id": "b", "status": "needs_changes" }, { "id": "c", "status": "reviewed", "passed": false }], "expected": { "ok": true, "supersede": null } },
    { "name": "después de una revisión, la pendiente espera (no se reemplaza)", "limits": { "before_review": null, "after_review": 2 }, "history": [{ "id": "a", "status": "needs_changes" }, { "id": "b", "status": "pending" }], "expected": { "ok": false, "code": "EV005", "message": "Tu entrega está esperando la revisión" } },
    { "name": "límite inválido cuenta como sin límite", "limits": { "before_review": -1, "after_review": "dos" }, "history": [{ "id": "a", "status": "superseded" }, { "id": "b", "status": "pending" }], "expected": { "ok": true, "supersede": "b" } }
  ]
}
