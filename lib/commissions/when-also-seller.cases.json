{
  "_comment": "Casos de applyWhenAlsoSeller (F75). Corren contra lib/commissions/rules.ts y contra public.commission_apply_max (verify-commissions).",
  "cases": [
    {
      "name": "dos comisiones de la misma persona con both: las dos",
      "evals": [
        {
          "role": "vendedor",
          "payee": "sale_vendedor",
          "whenAlsoSeller": "both",
          "applies": true,
          "userId": "aaaaaaaa-0000-4000-8000-0000000000d1",
          "amountCents": 5000
        },
        {
          "role": "afiliado",
          "payee": "sale_affiliate",
          "whenAlsoSeller": "both",
          "applies": true,
          "userId": "aaaaaaaa-0000-4000-8000-0000000000d1",
          "amountCents": 10000
        }
      ],
      "expected": [
        true,
        true
      ]
    },
    {
      "name": "max: queda la del afiliado (100 > 50)",
      "evals": [
        {
          "role": "vendedor",
          "payee": "sale_vendedor",
          "whenAlsoSeller": "both",
          "applies": true,
          "userId": "aaaaaaaa-0000-4000-8000-0000000000d1",
          "amountCents": 5000
        },
        {
          "role": "afiliado",
          "payee": "sale_affiliate",
          "whenAlsoSeller": "max",
          "applies": true,
          "userId": "aaaaaaaa-0000-4000-8000-0000000000d1",
          "amountCents": 10000
        }
      ],
      "expected": [
        false,
        true
      ]
    },
    {
      "name": "max: queda la del vendedor (80 > 50)",
      "evals": [
        {
          "role": "vendedor",
          "payee": "sale_vendedor",
          "whenAlsoSeller": "both",
          "applies": true,
          "userId": "aaaaaaaa-0000-4000-8000-0000000000d1",
          "amountCents": 8000
        },
        {
          "role": "afiliado",
          "payee": "sale_affiliate",
          "whenAlsoSeller": "max",
          "applies": true,
          "userId": "aaaaaaaa-0000-4000-8000-0000000000d1",
          "amountCents": 5000
        }
      ],
      "expected": [
        true,
        false
      ]
    },
    {
      "name": "max con empate: queda la del otro rol",
      "evals": [
        {
          "role": "setter",
          "payee": "sale_setter",
          "whenAlsoSeller": "both",
          "applies": true,
          "userId": "aaaaaaaa-0000-4000-8000-0000000000d1",
          "amountCents": 5000
        },
        {
          "role": "afiliado",
          "payee": "sale_affiliate",
          "whenAlsoSeller": "max",
          "applies": true,
          "userId": "aaaaaaaa-0000-4000-8000-0000000000d1",
          "amountCents": 5000
        }
      ],
      "expected": [
        true,
        false
      ]
    },
    {
      "name": "max con otra persona de vendedor: las dos",
      "evals": [
        {
          "role": "vendedor",
          "payee": "sale_vendedor",
          "whenAlsoSeller": "both",
          "applies": true,
          "userId": "otra",
          "amountCents": 5000
        },
        {
          "role": "afiliado",
          "payee": "sale_affiliate",
          "whenAlsoSeller": "max",
          "applies": true,
          "userId": "aaaaaaaa-0000-4000-8000-0000000000d1",
          "amountCents": 10000
        }
      ],
      "expected": [
        true,
        true
      ]
    },
    {
      "name": "max con afiliado contacto: no compara",
      "evals": [
        {
          "role": "vendedor",
          "payee": "sale_vendedor",
          "whenAlsoSeller": "both",
          "applies": true,
          "userId": "aaaaaaaa-0000-4000-8000-0000000000d1",
          "amountCents": 5000
        },
        {
          "role": "afiliado",
          "payee": "sale_affiliate",
          "whenAlsoSeller": "max",
          "applies": true,
          "userId": null,
          "amountCents": 10000
        }
      ],
      "expected": [
        true,
        true
      ]
    }
  ]
