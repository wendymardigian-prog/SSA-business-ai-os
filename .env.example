# ============================================================
# Supabase
# ============================================================
# Panel de Supabase → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# Project Settings → API Keys → service_role. SOLO del lado del servidor:
# saltea RLS. Nunca la pongas en una variable NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# URL base de las Edge Functions (receptor publico de webhooks).
# Se deduce sola de NEXT_PUBLIC_SUPABASE_URL; definila solo si usas un dominio
# propio para las funciones.
# NEXT_PUBLIC_SUPABASE_FUNCTIONS_URL=https://tu-proyecto.supabase.co/functions/v1

# ============================================================
# App
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Protege /api/cron/*. Cualquier string aleatorio largo:
#   openssl rand -hex 32
CRON_SECRET=tu-cron-secret

# ============================================================
# Instagram (Zernio)
# ============================================================
# La API key de Zernio NO va aca: se pega desde la pantalla de Settings y se
# guarda por workspace. El secreto para validar la firma de sus webhooks lo
# genera la app sola (workspaces.webhook_secret).

# ============================================================
# WhatsApp (Evolution API, Baileys)
# ============================================================
# URL del servicio de Evolution. En Railway: Settings → Networking → Public
# Domain. Cuando la app tambien este en Railway, cambiala por la URL de la red
# privada interna para que no salga a internet.
EVOLUTION_API_URL=https://tu-evolution.up.railway.app

# API key global de Evolution: es el valor de la variable AUTHENTICATION_API_KEY
# del servicio de Evolution en Railway.
EVOLUTION_API_KEY=tu-evolution-api-key

# Prefijo de las instancias que crea ESTE proyecto. Sirve para no chocar con las
# instancias de otro sistema si compartis el mismo Evolution. No lo cambies una
# vez que ya hay instancias creadas: el canal las busca por nombre.
EVOLUTION_INSTANCE_PREFIX=ssa

# Token compartido que Evolution manda en el header x-webhook-token y que la
# Edge Function exige. Es lo unico que separa un evento real de cualquiera que
# descubra la URL publica del webhook. Generalo con:
#   openssl rand -hex 32
# El MISMO valor tiene que estar en la Edge Function:
#   supabase secrets set EVOLUTION_WEBHOOK_TOKEN=<el mismo valor>
EVOLUTION_WEBHOOK_TOKEN=

# ============================================================
# IA (opcional en Fase 1 — el BYOK multi-proveedor llega en el Bloque 2)
# ============================================================
# Fallback del nodo AI Response para self-hosted: https://vercel.com/ai-gateway
# AI_GATEWAY_API_KEY=tu-gateway-key
