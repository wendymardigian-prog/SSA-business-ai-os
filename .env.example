# ============================================================
# Supabase
# ============================================================
# Panel de Supabase → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# Project Settings → API Keys → service_role. SOLO del lado del servidor:
# saltea RLS. Nunca la pongas en una variable NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# ============================================================
# App
# ============================================================
# Dominio publico de la app. Ademas de armar los links de invitacion, es la URL
# que se registra en Zernio y en Evolution para que manden sus webhooks: si
# apunta a localhost no entra ni un mensaje, y por eso el registro se niega a
# hacerlo (lib/webhook-url.ts). En Railway: Settings -> Networking -> Public Domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Protege /api/cron/*. Cualquier string aleatorio largo:
#   openssl rand -hex 32
#
# Quien le pega a esas rutas es la base: los crons corren con pg_cron dentro de
# Supabase (migracion 00036), no con un servicio externo. Por eso este mismo
# valor tiene que estar cargado ADEMAS en la tabla private.system_config, junto
# con NEXT_PUBLIC_APP_URL:
#
#   INSERT INTO private.system_config (key, value) VALUES
#     ('app_url', 'https://tu-app.up.railway.app'),
#     ('cron_secret', 'el-mismo-valor-de-aca')
#   ON CONFLICT (key) DO UPDATE SET value = EXCLUDED.value, updated_at = now();
#
# Si los dos valores no coinciden, los crons responden 401 y las secuencias,
# los delays de los flows y el trigger de inactividad dejan de correr.
# El secreto viaja SOLO por el header Authorization: Bearer <CRON_SECRET>.
# Un cron externo hecho a mano con ?key=... en la URL no autoriza.
CRON_SECRET=tu-cron-secret

# ============================================================
# Instagram (Zernio)
# ============================================================
# Los webhooks entrantes de los dos canales los recibe la app:
#   Instagram -> /api/webhooks/late      (firma HMAC)
#   WhatsApp  -> /api/webhooks/evolution (token compartido)
#
# La API key de Zernio NO va aca: se pega en /dashboard/settings/integrations y
# se guarda encriptada en Supabase Vault, por workspace. El secreto para validar
# la firma de sus webhooks lo genera la app sola (workspaces.webhook_secret).

# ============================================================
# WhatsApp (Evolution API, Baileys)
# ============================================================
# URL del servicio de Evolution. En Railway: Settings → Networking → Public
# Domain. Cuando la app tambien este en Railway, cambiala por la URL de la red
# privada interna para que no salga a internet.
EVOLUTION_API_URL=https://tu-evolution.up.railway.app

# API key global de Evolution: es el valor de la variable AUTHENTICATION_API_KEY
# del servicio de Evolution en Railway.
EVOLUTION_API_KEY=tu-evolution-api-key

# Prefijo de las instancias que crea ESTE proyecto. Sirve para no chocar con las
# instancias de otro sistema si compartis el mismo Evolution. No lo cambies una
# vez que ya hay instancias creadas: el canal las busca por nombre.
EVOLUTION_INSTANCE_PREFIX=ssa

# Token compartido que Evolution manda en el header x-webhook-token y que
# /api/webhooks/evolution exige. Es lo unico que separa un evento real de
# cualquiera que descubra la URL publica del webhook. Generalo con:
#   openssl rand -hex 32
# Se configura solo en la app: cuando se crea la instancia de WhatsApp, la app
# se lo pasa a Evolution para que lo mande en cada evento.
EVOLUTION_WEBHOOK_TOKEN=

# ============================================================
# Email saliente (Resend) e IA (BYOK)
# ============================================================
# Ninguna de estas keys va en variables de entorno. Se pegan desde
# /dashboard/settings/integrations y se guardan encriptadas en Supabase Vault:
#   - Resend (invitaciones y avisos por email)
#   - OpenAI / Anthropic / Google (BYOK, tu propia cuenta) — generan TEXTO
#   - Voyage AI (BYOK) — genera EMBEDDINGS para la base de conocimiento
# El sistema funciona con todas sin conectar: los emails quedan registrados como
# pendientes y las invitaciones muestran el link en pantalla para pasarlo a mano.
#
# Voyage y el proveedor de chat son independientes: Voyage SOLO hace embeddings,
# no genera texto, asi que se puede usar Anthropic para conversar y Voyage para
# indexar. Sin la key de Voyage la base de conocimiento no indexa (los
# documentos quedan en "error" con el motivo) y el resto del sistema sigue
# funcionando igual.
#
# Modelo de embeddings por defecto: voyage-4-lite, 1024 dimensiones.
# La columna knowledge_chunks.embedding esta anclada a vector(1024): cambiar de
# modelo o de dimension obliga a cambiar el tipo de la columna, recrear el
# indice HNSW y REINDEXAR todos los documentos. Ver la migracion 00049.
# Se elige desde la misma pantalla de Integraciones, no por variable de entorno.

# Fallback del nodo AI Response de ZernFlow para self-hosted. Se reemplaza por
# el BYOK multi-proveedor en la Fase 2: https://vercel.com/ai-gateway
# AI_GATEWAY_API_KEY=tu-gateway-key
